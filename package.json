{
  "name": "hyundai-department-dw",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && vite build",
    "preview": "uv run --locked python -m backend",
    "start": "uv run --locked python -m backend",
    "db:seed": "uv run --locked python -m backend.seed",
    "test": "node scripts/test.mjs",
    "db:up": "docker compose up -d --wait mysql",
    "db:down": "docker compose down",
    "test:mysql": "uv run --locked python -m pytest tests/python/test_mysql.py -q --mysql"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
