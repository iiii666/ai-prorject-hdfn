# Server-only OpenAI credentials. Never commit real keys or use VITE_ prefixes.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Local Docker Compose MySQL defaults. Match these values when changing credentials.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hyundai_dw
DB_USER=dw_app
DB_PASSWORD=dw_local_password
MYSQL_ROOT_PASSWORD=dw_local_root_password

# Optional: only when initializing an EMPTY MySQL DB from an existing SQLite file.
# DB_IMPORT_SQLITE=data/hyundai-dw.sqlite
