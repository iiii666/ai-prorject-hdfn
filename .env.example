# Server-only OpenAI credentials. Never commit real keys or use VITE_ prefixes.
# Put real values only in .env (git-ignored), never in this example file.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# --- Database: Supabase (shared by every PC) ---------------------------------
# Supabase Dashboard > Connect > "Session pooler" connection string (IPv4 works, port 5432).
# Special characters in the password must be URL-encoded (@ -> %40, : -> %3A, / -> %2F, # -> %23).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres
# --- Database: local PostgreSQL instead (leave DATABASE_URL commented out) ----
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=hyundai_dw
# DB_USER=dw_app
# DB_PASSWORD=change-me

# SSL: remote hosts default to an encrypted connection without certificate verification;
# 127.0.0.1/localhost default to no SSL. Override with DB_SSL=false|require.
# To verify the server certificate, download the CA certificate from the Supabase
# dashboard (Database Settings > SSL Configuration) and set its path:
# DB_SSL_CA=./certs/prod-ca-2021.crt

# Optional: only when initializing an EMPTY database from an existing SQLite file.
# DB_IMPORT_SQLITE=data/hyundai-dw.sqlite
